"use client";

import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { useBankStatement } from "@/contexts/BankStatementContext";
import { getGeminiNLP } from "@/services/geminiNLPService";
import { 
  Sparkles, 
  Loader2, 
  TrendingUp, 
  BarChart3 
} from "lucide-react";
import { 
  ResponsiveContainer, 
  LineChart, 
  Line, 
  XAxis, 
  YAxis, 
  CartesianGrid, 
  Tooltip 
} from "recharts";

import React, { useState, useEffect } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { cn } from "@/lib/utils";
import { useBankStatement } from "@/contexts/BankStatementContext";
import { getGeminiNLP } from "@/services/geminiNLPService";
import { 
  Sparkles, 
  Loader2, 
  TrendingUp, 
  BarChart3 
} from "lucide-react";
import { 
  ResponsiveContainer, 
  LineChart, 
  Line, 
  XAxis, 
  YAxis, 
  CartesianGrid, 
  Tooltip 
} from "recharts";

interface FinancialMetrics {
  totalBalance: number;
  income: number;
  expenses: number;
  savingsRate: number;
}

interface CategoryData {
  name: string;
  value: number;
  percentage: number;
}

interface FinancialAnalysis {
  context: string;
  categoryBreakdown: CategoryData[];
  dayOfWeekSpending: Record<string, number>;
  recurringMerchants: Array<[string, { count: number; total: number }]>;
  metrics: FinancialMetrics;
}

function getFinancialContext(financialData: any): FinancialAnalysis {
  // Calculate total expenses
  const totalExpenses = financialData.transactions
    .filter((t: any) => t.amount < 0)
    .reduce((sum: number, t: any) => sum + Math.abs(t.amount), 0);

  // Calculate total income
  const totalIncome = financialData.transactions
    .filter((t: any) => t.amount > 0)
    .reduce((sum: number, t: any) => sum + t.amount, 0);

  // Group transactions by category and calculate totals
  const categoryTotals = financialData.transactions
    .filter((t: any) => t.amount < 0)
    .reduce((acc: Record<string, number>, t: any) => {
      const category = t.category || 'Uncategorized';
      acc[category] = (acc[category] || 0) + Math.abs(t.amount);
      return acc;
    }, {});

  // Sort categories by value and calculate percentages
  const categoryBreakdown: CategoryData[] = Object.entries(categoryTotals)
    .map(([name, value]) => ({
      name,
      value,
      percentage: (value / totalExpenses) * 100
    }))
    .sort((a, b) => b.value - a.value);

  // Group transactions by day of week
  const dayOfWeekSpending: Record<string, number> = financialData.transactions
    .filter((t: any) => t.amount < 0)
    .reduce((acc: Record<string, number>, t: any) => {
      const date = new Date(t.date);
      const day = date.toLocaleDateString('en-US', { weekday: 'long' });
      acc[day] = (acc[day] || 0) + Math.abs(t.amount);
      return acc;
    }, {});

  // Find recurring merchants (3 or more transactions)
  const merchantFrequency = financialData.transactions
    .reduce((acc: Record<string, { count: number; total: number }>, t: any) => {
      if (t.merchant) {
        if (!acc[t.merchant]) {
          acc[t.merchant] = { count: 0, total: 0 };
        }
        acc[t.merchant].count += 1;
        acc[t.merchant].total += Math.abs(t.amount);
      }
      return acc;
    }, {});

  const recurringMerchants = Object.entries(merchantFrequency)
    .filter(([_, data]) => data.count >= 3)
    .sort((a, b) => b[1].total - a[1].total);

  // Calculate savings rate
  const savingsRate = totalIncome > 0 ? ((totalIncome - totalExpenses) / totalIncome) * 100 : 0;

  // Generate context string
  const context = `
    Financial Summary:
    - Total Income: ₹${totalIncome.toLocaleString('en-IN')}
    - Total Expenses: ₹${totalExpenses.toLocaleString('en-IN')}
    - Savings Rate: ${savingsRate.toFixed(1)}%
    
    Top Categories:
    ${categoryBreakdown.slice(0, 5).map(cat => 
      `- ${cat.name}: ₹${cat.value.toLocaleString('en-IN')} (${cat.percentage.toFixed(1)}%)`
    ).join('\n')}
    
    Notable Recurring Expenses:
    ${recurringMerchants.slice(0, 5).map(([merchant, data]) => 
      `- ${merchant}: ${data.count} transactions, total ₹${data.total.toLocaleString('en-IN')}`
    ).join('\n')}
  `.trim();

  return {
    context,
    categoryBreakdown,
    dayOfWeekSpending,
    recurringMerchants,
    metrics: {
      totalBalance: financialData.balance || 0,
      income: totalIncome,
      expenses: totalExpenses,
      savingsRate
    }
  };
}

interface AIInsightsProps {
  isBlurred?: boolean;
}

export default function AIInsights({ isBlurred = false }: AIInsightsProps) {
  const { hasUploadedStatement, financialData } = useBankStatement();
  const [insights, setInsights] = useState<string[]>([]);
  const [spendingTrends, setSpendingTrends] = useState<{ name: string; amount: number }[]>([]);
  const [categoryBreakdown, setCategoryBreakdown] = useState<{ name: string; value: number }[]>([]);
  const [isLoading, setIsLoading] = useState(false);
  const [isGeneratingInsights, setIsGeneratingInsights] = useState(false);

  // Generate insights based on financial data
  useEffect(() => {
    if (!hasUploadedStatement || isBlurred) return;

    const analyzeData = async () => {
      try {
        setIsLoading(true);

        // Get deterministic financial analysis
        const { categoryBreakdown, metrics } = getFinancialContext(financialData);
        
        // Generate deterministic insights first for immediate display
        const baseInsights = [
          metrics.savingsRate > 30 
            ? `Great job! You're saving ${metrics.savingsRate.toFixed(1)}% of your income. This is above the recommended 20% savings rate.`
            : metrics.savingsRate > 20
            ? `You're saving ${metrics.savingsRate.toFixed(1)}% of your income, which is aligned with the recommended 20% savings rate.`
            : metrics.savingsRate > 0
            ? `You're saving ${metrics.savingsRate.toFixed(1)}% of your income. Consider increasing your savings to reach the recommended 20% rate.`
            : `You're spending more than your income. Consider reviewing your expenses to avoid going into debt.`,
          `Your largest expense category is ${categoryBreakdown[0].name}, accounting for ${categoryBreakdown[0].percentage.toFixed(1)}% of your total expenses.`,
        ];

        if (financialData.comparedToLastMonth && financialData.comparedToLastMonth !== '₹0' && financialData.comparedToLastMonth !== '₹0+') {
          const isPositive = financialData.comparedToLastMonth.includes('+');
          baseInsights.push(
            isPositive
              ? `Your balance has increased by ${financialData.comparedToLastMonth} compared to last month. Keep up the good work!`
              : `Your balance has decreased by ${financialData.comparedToLastMonth} compared to last month. Consider reviewing your expenses.`
          );
        }
        
        setInsights(baseInsights);
        
        // Then enhance with AI-generated insights if possible
        if (process.env.NEXT_PUBLIC_GEMINI_API_KEY) {
          const nlpService = getGeminiNLP();
          if (nlpService) {
            setIsGeneratingInsights(true);
            try {
              const { context } = getFinancialContext(financialData);
              const prompt = `Based on the following financial data, provide 3-5 insightful, specific, and actionable financial observations or recommendations. Format each insight as a concise paragraph with specific numbers and percentages from the data.`;

              const aiInsightsText = await nlpService.generateResponse(prompt, context);
              
              if (aiInsightsText) {
                const aiInsights = aiInsightsText
                  .split(/\n\s*\n|\n-\s*/)
                  .map(insight => insight.trim())
                  .filter(insight => insight.length > 10)
                  .map(insight => insight.replace(/^\d+\.\s*/, '').trim());

                if (aiInsights.length > 0) {
                  setInsights(prev => {
                    const combinedInsights = [...aiInsights];
                    // Add some deterministic insights if needed to have at least 3 total
                    while (combinedInsights.length < 3 && prev.length > 0) {
                      combinedInsights.push(prev[combinedInsights.length]);
                    }
                    return combinedInsights;
                  });
                }
              }
            } catch (error) {
              console.error('Error generating AI insights:', error);
              // Keep using deterministic insights
            }
          }
        }
      } catch (error) {
        console.error('Error analyzing data:', error);
      } finally {
        setIsLoading(false);
        setIsGeneratingInsights(false);
      }
    };

    analyzeData();
  }, [hasUploadedStatement, financialData, isBlurred]);

  return (
    <Card className={cn(
      "bg-background/10 backdrop-blur-sm border-border/30 w-full mt-6 transition-all shadow-md hover:shadow-lg",
      isBlurred && "hover:opacity-60"
    )}>
      <CardHeader className="pb-2 border-b border-border/20">
        <div className="flex justify-between items-center">
          <CardTitle className="text-lg font-medium flex items-center">
            <Sparkles className="h-5 w-5 mr-2 text-primary" />
            AI INSIGHTS
          </CardTitle>
          {isGeneratingInsights && (
            <div className="flex items-center text-xs text-primary-foreground px-2 py-1 bg-primary/20 rounded-full">
              <Loader2 className="h-3 w-3 mr-1 animate-spin" />
              Enhancing insights...
            </div>
          )}
        </div>
      </CardHeader>
      
      <CardContent className={cn("p-4", isBlurred && "blur-sm select-none")}>
        {isLoading ? (
          <div className="flex justify-center items-center py-8">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
          </div>
        ) : !hasUploadedStatement ? (
          <div className="text-center py-10">
            <p className="text-muted-foreground">No insights available.</p>
            <p className="text-sm text-muted-foreground mt-2">Upload a bank statement to view AI-powered insights.</p>
          </div>
        ) : (
          <div className="space-y-6">
            <div>
              <h3 className="text-md font-medium mb-2 flex items-center">
                <Sparkles className="h-4 w-4 mr-2 text-primary" />
                Financial Insights
              </h3>
              <ul className="space-y-2">
                {insights.map((insight, index) => (
                  <li key={index} className="p-3 rounded-lg border border-border/30 bg-background/5 shadow-sm hover:shadow-md transition-shadow">
                    {insight}
                  </li>
                ))}
              </ul>
            </div>
            
            {spendingTrends.length > 0 && (
              <div>
                <h3 className="text-md font-medium mb-2 flex items-center">
                  <TrendingUp className="h-4 w-4 mr-2 text-primary" />
                  Spending Trends
                </h3>
                <div className="h-60 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <LineChart
                      data={spendingTrends}
                      margin={{ top: 5, right: 5, left: 0, bottom: 5 }}
                    >
                      <CartesianGrid stroke="rgba(255, 255, 255, 0.1)" vertical={false} />
                      <XAxis dataKey="name" stroke="rgba(255, 255, 255, 0.5)" />
                      <YAxis 
                        stroke="rgba(255, 255, 255, 0.5)" 
                        tickFormatter={(value) => `₹${value / 1000}k`}
                      />
                      <Tooltip 
                        formatter={(value: number) => [`₹${value.toLocaleString('en-IN')}`, 'Amount']}
                        contentStyle={{ 
                          backgroundColor: 'rgba(0, 0, 0, 0.8)', 
                          border: '1px solid rgba(255, 255, 255, 0.2)',
                          color: 'white',
                          borderRadius: '8px',
                        }} 
                      />
                      <Line 
                        type="monotone"
                        dataKey="amount"
                        stroke="#4caf50"
                        strokeWidth={2}
                        dot={false}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </div>
            )}
            
            {categoryBreakdown.length > 0 && (
              <div>
                <h3 className="text-md font-medium mb-2 flex items-center">
                  <BarChart3 className="h-4 w-4 mr-2 text-primary" />
                  Category Breakdown
                </h3>
                <div className="flex flex-col space-y-4">
                  {categoryBreakdown.map((category) => (
                    <div key={category.name} className="flex items-center justify-between">
                      <span className="text-sm text-muted-foreground truncate">{category.name}</span>
                      <div className="flex-1 h-2.5 rounded-full bg-border/20 overflow-hidden mx-3">
                        <div 
                          className="h-full bg-primary"
                          style={{ width: `${category.percentage}%` }}
                        />
                        <span className="text-sm text-muted-foreground">
                          ₹{category.value.toLocaleString('en-IN')}
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
                        />
                      </div>
                      <span className="text-sm font-medium text-primary">
                        {`₹${category.value.toLocaleString('en-IN')}`}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
      </CardContent>
    </Card>
  );
}
